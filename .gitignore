# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build
/.next/
/out/

# Production
/build

# Env files — never commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Test artifacts
.playwright-mcp/
settings-verified.png
*.test-artifact.png
/test-results/
/playwright-report/
/vp-*.png
/tmp/

# Large statutory data (generated from PDFs via extract scripts)
scripts/pcb-data.json

# gstack QA reports (generated artifacts, not source)
.gstack/qa-reports/screenshots/

# gstack retro snapshots (local history, not source)
.context/retros/

# Claude Code local settings (per-user). Ignore everything by default ...
.claude/*
# ... but keep these project-level shared folders under version control:
!.claude/agents/
!.claude/personas/
!.claude/flows/
!.claude/agent-shared/

# E2E test screenshot artifacts (local only)
/e2e-screenshots/

# Design audit screenshots (local session only)
/design-audit/

# Superpowers brainstorm visual companion (local mockup persistence)
.superpowers/
qa-*.png
motion-*.png
spatial-*.png
visual-*.png
.gstack/

.env.local.shared

# Local backup copies (Windows "Name - Copy") must never ship
src/**/*\ -\ Copy.*

# Cloudflare Workers portability spike — throwaway, lives outside the repo
# at ../pdf-spike. Ignored so a stray re-scaffold never gets committed.
/pdf-spike/

# OpenNext build output
/.open-next/

# Pipeline working notes (coach log, decisions, review, checklists).
# Scratch for the build process, not part of the product.
/docs/pipeline/

# Wrangler local state — workerd's dev cache and temp builds. Grows to hundreds
# of MB and is rebuilt from scratch on every `wrangler dev`.
/.wrangler/

# Bundle-size measurement output:
#   npx wrangler deploy --dry-run --outdir dist
# Keep --dry-run. Without it that command publishes.
/dist/
