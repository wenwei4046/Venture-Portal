# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build
/.next/
/out/

# Production
/build

# Env files — never commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Test artifacts
.playwright-mcp/
settings-verified.png
*.test-artifact.png
/test-results/
/playwright-report/
/vp-*.png
/tmp/

# Large statutory data (generated from PDFs via extract scripts)
scripts/pcb-data.json

# gstack QA reports (generated artifacts, not source)
.gstack/qa-reports/screenshots/

# gstack retro snapshots (local history, not source)
.context/retros/

# Claude Code local settings (per-user). Ignore everything by default ...
.claude/*
# ... but keep these project-level shared folders under version control:
!.claude/agents/
!.claude/personas/
!.claude/flows/
!.claude/agent-shared/

# E2E test screenshot artifacts (local only)
/e2e-screenshots/

# Design audit screenshots (local session only)
/design-audit/

# Superpowers brainstorm visual companion (local mockup persistence)
.superpowers/
qa-*.png
motion-*.png
spatial-*.png
visual-*.png
.gstack/

.env.local.shared
